.env
.env.*
!.env.example
*.pem
*.key

# Node / frontend
node_modules/
frontend/dist/

# Editors
.idea/
.vscode/

# Sandbox demo — kept as its own separate repo for demonstrating the system
sandbox/

# macOS
.DS_Store
