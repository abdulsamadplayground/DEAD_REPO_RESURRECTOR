# Dead Repo Resurrector — example environment / credentials
#
# Copy to `.env` for LOCAL development only. In production every secret lives in
# AWS Secrets Manager (see docs/infrastructure.md) and is loaded at runtime —
# never commit real values.

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------
# Fine-grained Personal Access Token. Minimal scopes:
#   contents:write, pull-requests:write, issues:write
# Locally, code reads GITHUB_TOKEN first; in AWS it comes from the secret
# referenced by RESURRECTOR_GITHUB_TOKEN_SECRET_ID.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
RESURRECTOR_GITHUB_TOKEN_SECRET_ID=/resurrector/github-token

# HMAC secret used to verify inbound GitHub webhook payloads.
RESURRECTOR_WEBHOOK_SECRET_ID=/resurrector/webhook-secret

# ---------------------------------------------------------------------------
# Model provider (Amazon Bedrock or Gemini)
# ---------------------------------------------------------------------------
# One of: bedrock | gemini
RESURRECTOR_MODEL_PROVIDER=gemini
RESURRECTOR_MODEL_ID=gemini-3.6-flash
# Secrets Manager id for the Gemini API key (when provider=gemini).
RESURRECTOR_GEMINI_SECRET_ID=/resurrector/gemini-key
# Region where Bedrock model access is enabled (when provider=bedrock).
RESURRECTOR_BEDROCK_REGION=us-east-1
# Optional pause (seconds) between the Analyst and Engineer to respect
# per-minute model rate limits (free tiers). 0 disables it.
RESURRECTOR_MODEL_PACE_SECONDS=65

# ---------------------------------------------------------------------------
# AWS resources (names/URLs are normally injected by the SAM template)
# ---------------------------------------------------------------------------
RESURRECTOR_STATE_TABLE=ResurrectorState
RESURRECTOR_CANDIDATE_QUEUE_URL=
RESURRECTOR_SNS_TOPIC_ARN=

# ---------------------------------------------------------------------------
# Discovery / behavior tuning (all optional; sensible defaults in code)
# ---------------------------------------------------------------------------
RESURRECTOR_SEARCH_MIN_STARS=10
RESURRECTOR_SEARCH_MAX_STARS=500
RESURRECTOR_SEARCH_AGE_MONTHS=8
RESURRECTOR_SEARCH_MIN_OPEN_ISSUES=20
RESURRECTOR_SEARCH_MAX_RESULTS=20
RESURRECTOR_REEVALUATION_DAYS=30
RESURRECTOR_LIVE_MAX_RESULTS=8

# Engineer deadline (seconds), inside the 15-min Lambda ceiling.
RESURRECTOR_ENGINEER_TIMEOUT_SECONDS=600
# Third-party test execution is OFF by default (arbitrary code execution risk).
# Set to "1" only in a sandboxed environment you control.
RESURRECTOR_ALLOW_TEST_EXECUTION=0

# ---------------------------------------------------------------------------
# Frontend (build/deploy time) — the dashboard resolves these at runtime too
# ---------------------------------------------------------------------------
# The deployed /state and /live API URLs the dashboard reads.
DASHBOARD_API_URL=
DASHBOARD_LIVE_URL=
